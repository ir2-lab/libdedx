@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Import the targets created by install(EXPORT ...)
include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

# Basic compatibility variables for find_package(...) users
set(@PROJECT_NAME@_FOUND TRUE)
set(@PROJECT_NAME@_VERSION "@PROJECT_VERSION@")

# Provide include dir and libraries variables for consumers
set(@PROJECT_NAME@_INCLUDE_DIRS "@PACKAGE_PREFIX_DIR@/${CMAKE_INSTALL_INCLUDEDIR}")
# The exported target for the library is the 'dedx' target installed by the package
set(@PROJECT_NAME@_LIBRARIES @PROJECT_NAME@::dedx)